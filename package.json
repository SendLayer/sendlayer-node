{
  "name": "sendlayer",
  "version": "1.1.0",
  "description": "SendLayer JavaScript SDK",
  "main": "./dist/index.js",
  "files": [
    "dist/**/*",
    "CHANGELOG.md"
  ],
  "directories": {
    "dist": "./dist"
  },
  "types": "./dist",
  "sideEffects": false,
  "scripts": {
