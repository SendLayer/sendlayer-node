    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "sendlayer",
    "email api",
    "send email nodejs"
  ],
  "author": {
    "name": "SendLayer",
    "email": "support@sendlayer.com"
  },
